+
+int
+sys_lseek(void){
+ // I need to get the proc which is running on the cpu
+  struct proc* curproc = myproc();
+  int *pfd;
+  struct file *pf;
+  if (argfd(0, pfd, &pf) < 0) return -1;
+  int *offPtr;
+  if (argint(1, offPtr) < 0) return -1;
+  int whence;
+  if (argint(2, &whence) < 0) return -1;
+
+  switch (whence)
+  {
+  case SEEK_SET:
+    pf->off = *offPtr;
+    break;
+  case SEEK_CURR:
+    pf->off += *offPtr;
+    break;
+  case SEEK_END:
+    pf->off =  pf->ip->size + *offPtr;
+    break;
+  default:
+    break;
+  }
+  return 0;
+}
